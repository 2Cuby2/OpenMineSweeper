{
  "expo": {
    "name": "MineSweeper",
    "slug": "minesweeper",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/bomb_icon.png",
    "scheme": "minesweeper",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["android"],
    "android": {
      "package": "com.github.dCuby2.MineSweeper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images//bomb_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../assets/bomb_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
