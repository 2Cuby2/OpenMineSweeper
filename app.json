{
  "expo": {
    "name": "OpenMineSweeper",
    "slug": "openminesweeper",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/bomb_icon.png",
    "scheme": "openminesweeper",
    "userInterfaceStyle": "black",
    "newArchEnabled": true,
    "backgroundColor": "#1d1b1e",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.github.2Cuby2.MineSweeper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bomb_icon.png",
        "backgroundColor": "#1d1b1e"
      },
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bomb_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1d1b1e",
          "dark": {
            "backgroundColor": "#1d1b1e"
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
